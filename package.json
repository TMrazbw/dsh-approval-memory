{
  "name": "@local/dsh-approval-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DAM: records and classifies DSH approval requests, shows counts and risk, and auto-approves user-enabled read-only request classes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TMrazbw/dsh-approval-memory.git"
  },
  "homepage": "https://github.com/TMrazbw/dsh-approval-memory#readme",
  "bugs": {
    "url": "https://github.com/TMrazbw/dsh-approval-memory/issues"
  },
  "scripts": {
    "test": "node --test --test-isolation=none"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
